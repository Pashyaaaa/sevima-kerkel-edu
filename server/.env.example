# Koneksi database MySQL (bisa pakai `npx create-db` untuk dapat Postgres gratis,
# tapi schema ini pakai provider "mysql" jadi pastikan connection string MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/koreksi"

# Secret untuk sign JWT - ganti dengan random string yang kuat di production
JWT_SECRET="ganti-dengan-secret-yang-panjang-dan-acak"

# Berapa lama token berlaku
JWT_EXPIRES_IN="7d"

PORT=3000
